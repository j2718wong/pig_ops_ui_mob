.data-table {
    width: 100%;
    border-collapse: collapse;
    box-sizing: border-box;
    table-layout: fixed; 
    display: table;
}

.data-table th {
    background-color: var(--corporate-blue-company);
    color: white;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left:6px;
    padding-right:0;
    text-align: left;
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.data-table tr {
    border-bottom: 1px solid var(--medium-gray);
    
}

.data-table td {
    padding: 5px 4px;
    font-size: 15px;
    vertical-align: top;
    overflow: hidden;
    text-overflow: ellipsis;
    word-wrap: break-word;
    overflow-wrap: break-word;
}

.data-table tr:nth-child(even) {
    background-color: var(--row-even);
}

.data-table tr.completed {
    opacity: 0.8;
}

.data-table tr.hidden {
    display: none;
}

.data-table tr:hover {
    background-color: #e0f2fe;
}

